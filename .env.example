# Edison X configuration. Copy to .env and fill in. Never commit real values.

NODE_ENV=development
# HTTP port and bind address (TRANSPORT=http only). Keep 127.0.0.1 unless a reverse proxy terminates TLS in front.
PORT=8787
BIND_HOST=127.0.0.1
# stdio (local agent) or http (remote agents, Streamable HTTP)
TRANSPORT=stdio
DATABASE_PATH=./data/edison-x.db
# 32 random bytes, base64. Generate with: pnpm gen:key
# Encrypts OAuth tokens at rest and signs cursors and connect links. Losing it disconnects every user.
TOKEN_ENCRYPTION_KEY=
# Public https URL of this server (used for OAuth redirects and connect links). Required when pinterest is enabled.
PUBLIC_BASE_URL=
# Browser origins allowed to call the HTTP transport. Empty = reject any request that carries an Origin header.
ALLOWED_ORIGINS=
# Set true only behind a reverse proxy you control: client IPs are then read from X-Forwarded-For.
TRUST_PROXY=false
# Comma list of sources to load, e.g. library,pinterest. A source also needs a complete entry in docs/SOURCES.md.
ENABLED_SOURCES=library
SOURCES_REGISTER_PATH=./docs/SOURCES.md
LIBRARY_SEED_PATH=./library/seed-designs.json
# Hosts the owner's own library images may be served from (comma list). Empty disables image proxying.
LIBRARY_IMAGE_HOSTS=
# Local principal used by the stdio transport: a preset (search-only, curator, owner) or a scope list.
STDIO_PRINCIPAL_NAME=local-owner
STDIO_SCOPES=owner

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=

# Analysis layer (model-written design analysis). Off by default.
ANALYSIS_ENABLED=false
# Hard daily spend cap in USD. Required when analysis is enabled.
ANALYSIS_DAILY_COST_CAP=
# Minutes between background analysis runs (only when enabled).
ANALYSIS_INTERVAL_MINUTES=10
ANALYSIS_MODEL=claude-opus-5-5
# USD per million tokens, used to meter the cap. Defaults match claude-opus-5-5.
ANALYSIS_PRICE_IN_PER_MTOK=4
ANALYSIS_PRICE_OUT_PER_MTOK=20
ANTHROPIC_API_KEY=

LOG_LEVEL=info
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_PER_DAY=1000
# Whole tool call timeout and per-source timeout, in milliseconds.
TOOL_TIMEOUT_MS=15000
SOURCE_TIMEOUT_MS=5000
